PORT=8787
HOST=0.0.0.0

# Public HTTPS origin where ChatGPT reaches this bridge.
PUBLIC_BASE_URL=https://sparky-mcp.example.com
PUBLIC_MCP_RESOURCE=https://sparky-mcp.example.com
OAUTH_ISSUER=https://sparky-mcp.example.com
OAUTH_SIGNING_SECRET=replace-with-at-least-32-random-bytes
OAUTH_SCOPES=sparky:read sparky:write
OAUTH_ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com
ADMIN_DIAGNOSTICS_TOKEN=
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=31536000
AUTHORIZATION_CODE_TTL_SECONDS=300
UPSTREAM_REQUEST_TIMEOUT_MS=30000
RESOURCE_DOCUMENTATION_URL=https://sparky-mcp.example.com/docs

# Private upstream Sparky MCP. This should not be exposed publicly.
SPARKY_MCP_URL=http://sparky-mcp:8788/mcp
SPARKY_MCP_BEARER_TOKEN=replace-with-sparky-mcp-token
